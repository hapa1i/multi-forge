# Couple the Forge proxy and Claude Code in one sidecar lifecycle.
# Used by `forge session start --sidecar`.
#
# Build with the canonical runner, which builds the base and this layer:
#   ./scripts/test-integration.sh           # builds forge-sidecar:latest from the fresh base
#   docker build -f docker/Dockerfile.sidecar -t forge-sidecar:latest .
#   docker build -f docker/Dockerfile.sidecar --build-arg BASE_IMAGE=forge-claude-test:2.1.158 -t forge-sidecar:latest .
#
# forge-claude-test includes:
#   - Python 3.12 + uv
#   - Node.js + npm
#   - Claude Code
#   - Forge installed by uv sync
#
# Usage (via forge CLI, not directly):
#   forge session start my-feature --sidecar --template litellm-openai

# Base image tag. The integration runner tags the base by Claude version
# (forge-claude-test:<ver>) and passes it here so the sidecar tracks current source.
ARG BASE_IMAGE=forge-claude-test:latest
FROM ${BASE_IMAGE}

# The development image installs Forge into /forge/.venv. Production images may
# also provide a global launcher, but keeping the editable install on PATH makes
# the sidecar's bare `forge hook ...` and project `forge status-line` commands
# resolve consistently in both shapes.
ENV PATH="/forge/.venv/bin:${PATH}"

# Keep sidecar health checks independent of the base image contents.
RUN command -v curl > /dev/null || (apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*)

# On Linux, the sidecar uses the host uid:gid, which may have no passwd entry.
# The launcher sets HOME=/root, so the mapped uid must reach the mounts under /root
# and write /root/.claude.json. This image is for an ephemeral --rm sandbox.
RUN chmod 0777 /root

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/entrypoint.sh"]

LABEL org.opencontainers.image.title="Forge Sidecar Container"
LABEL org.opencontainers.image.description="Bundled Claude Code + Proxy execution environment"
